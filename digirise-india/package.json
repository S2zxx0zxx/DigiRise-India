{
  "name": "digirise-india",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev --listen 3001",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build && npm run build:blog && npm run build:rss",
    "build:blog": "tsx scripts/build-blog.js",
    "build:rss": "tsx scripts/generate-rss.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.js,.html",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true vite build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "prepare": "husky install",
    "vercel:dev": "vercel dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/client": "^5.22.0",
    "@sentry/browser": "^8.38.0",
    "@upstash/ratelimit": "^1.2.1",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^1.4.1",
    "@vercel/blob": "^0.26.0",
    "@vercel/node": "^3.2.26",
    "@vercel/og": "^0.6.4",
    "@vercel/speed-insights": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide": "^0.462.0",
    "posthog-js": "^1.192.1",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "front-matter": "^4.0.2",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.28.2",
    "lint-staged": "^15.2.10",
    "marked": "^15.0.3",
    "prettier": "^3.4.1",
    "prisma": "^5.22.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-sitemap": "^0.7.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
